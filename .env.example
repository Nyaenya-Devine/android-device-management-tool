# ─────────────────────────────────────────────────────────────
# Android Device Management Tool — environment
# Copy to .env and fill in. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (required — the app won't start without it)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/android_mdm

# Secret used to encrypt service-account private keys at rest (AES-256-GCM).
# Required in production and should be a high-entropy random value.
# Generate with: openssl rand -hex 32
CREDENTIALS_SECRET=

# Server-to-server API authentication. Never expose these values as NEXT_PUBLIC_*.
# Use separate credentials for the requester and the second-person approver.
MDM_API_TOKEN=
MDM_API_ACTOR=operator-1
MDM_API_ROLE=operator
MDM_APPROVER_TOKEN=
MDM_APPROVER_ACTOR=admin-1
MDM_APPROVER_ROLE=admin

# Used by the simulator only. When in LIVE_AMAPI mode, the app calls the real
# Android Management API with a service-account key you paste into the UI
# (it is encrypted with CREDENTIALS_SECRET before being stored).
NEXT_PUBLIC_APP_NAME=Android Device Management Tool
